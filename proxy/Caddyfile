{
	auto_https off
	admin off
}

(secured) {
	request_body {
		max_size 1MB
	}
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
}

:8080 {
	log {
		output stdout
		format json
	}

	handle /healthz {
		rewrite * /health
		reverse_proxy {$ANALYZER_URL} {
			transport http {
				dial_timeout 10s
				response_header_timeout 30s
			}
		}
	}

	handle /analyze* {
		import secured
		reverse_proxy {$ANALYZER_URL} {
			transport http {
				dial_timeout 10s
				response_header_timeout 120s
			}
		}
	}

	handle /anonymize* {
		import secured
		reverse_proxy {$ANONYMIZER_URL} {
			transport http {
				dial_timeout 10s
				response_header_timeout 120s
			}
		}
	}

	respond "not found" 404
}
